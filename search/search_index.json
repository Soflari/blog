ae0\u653e\u5728 <code>docs/blog/posts/</code> \u76ee\u5f55\u4e0b\uff0c\u6587\u4ef6\u540d\u5efa\u8bae\u7528\u300c\u65e5\u671f-\u6807\u9898\u7f29\u5199\u300d\u7684\u683c\u5f0f\uff0c\u4f8b\u5982\uff1a</p> <pre><code>docs/blog/posts/2026-09-06-hello-world.md\n</code></pre>","tags":["\u5f00\u59cb"]},{"location":"blog/2026/09/06/hello-world/#_3","title":"\u6587\u7ae0\u5f00\u5934\u7684\u5143\u6570\u636e","text":"<p>\u6bcf\u7bc7\u6587\u7ae0\u9876\u90e8\u6709\u4e00\u6bb5 YAML\u300cfront matter\u300d\uff0c\u7528\u6765\u58f0\u660e\u65e5\u671f\u3001\u5206\u7c7b\u3001\u6807\u7b7e\u548c\u4f5c\u8005\uff1a</p> <pre><code>---\ndate: 2026-09-06\ncategories:\n  - \u516c\u544a\ntags:\n  - \u5f00\u59cb\nauthors:\n  - me\n---\n</code></pre> <ul> <li><code>date</code>\uff1a\u53d1\u5e03\u65e5\u671f\uff0c\u535a\u5ba2\u9996\u9875\u6309\u5b83\u5012\u5e8f\u6392\u5217</li> <li><code>categories</code>\uff1a\u5206\u7c7b\uff0c\u51fa\u73b0\u5728\u5f52\u6863\u4e0e\u5206\u7c7b\u89c6\u56fe</li> <li><code>tags</code>\uff1a\u6807\u7b7e\uff0c\u70b9\u51fb\u53ef\u8df3\u5230\u540c\u6807\u7b7e\u6587\u7ae0\u5217\u8868</li> <li><code>authors</code>\uff1a\u4f5c\u8005\uff0c\u5bf9\u5e94 <code>docs/blog/.authors.yml</code> \u91cc\u5b9a\u4e49\u7684\u6761\u76ee</li> </ul>","tags":["\u5f00\u59cb"]},{"location":"blog/2026/09/06/hello-world/#_4","title":"\u516c\u5f0f\u6f14\u793a","text":"<p>\u884c\u5185\u516c\u5f0f\u8fd9\u6837\u5199\uff1a\\(e^{i\\pi} + 1 = 0\\)\u3002</p> <p>\u5757\u7ea7\u516c\u5f0f\u8fd9\u6837\u5199\uff1a</p> \\[ \\hat{\\theta} = \\arg\\min_{\\theta} \\sum_{i=1}^{n} \\left( y_i - f_\\theta(x_i) \\right)^2 \\] <p>\u66f4\u591a\u5199\u6cd5\uff08\u4ee3\u7801\u5757\u3001\u63d0\u793a\u6846\u3001\u8868\u683c\u3001\u9009\u9879\u5361\u7b49\uff09\u89c1\u4e0b\u4e00\u7bc7\u6587\u7ae0\u300a\u5199\u4f5c\u8bed\u6cd5\u6307\u5357\u300b\u3002</p>","tags":["\u5f00\u59cb"]},{"location":"blog/2026/09/06/markdown-guide/","title":"\u5199\u4f5c\u8bed\u6cd5\u6307\u5357","text":"<p>\u8fd9\u7bc7\u6587\u7ae0\u6f14\u793a\u672c\u7ad9\u652f\u6301\u7684\u4e3b\u8981\u5199\u4f5c\u8bed\u6cd5\uff0c\u5199\u65b0\u6587\u7ae0\u65f6\u53ef\u4ee5\u5f53\u6a21\u677f\u6284\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_2","title":"\u6587\u5b57\u683c\u5f0f","text":"<p>\u52a0\u7c97\u3001\u659c\u4f53\u3001<code>\u884c\u5185\u4ee3\u7801</code>\u3001~~\u5220\u9664\u7ebf~~\u3001\u9ad8\u4eae\u3001H~2~O \u4e0b\u6807\u3001x<sup>2</sup> \u4e0a\u6807\u3002</p> <p>\u5916\u90e8\u94fe\u63a5\u4f1a\u81ea\u52a8\u8bc6\u522b\uff0c\u7ad9\u5185\u94fe\u63a5\u793a\u4f8b\uff1a\u56de\u5230\u9996\u9875\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_3","title":"\u5217\u8868","text":"<p>\u65e0\u5e8f\u5217\u8868\uff1a</p> <ul> <li>\u7b2c\u4e00\u9879</li> <li>\u7b2c\u4e8c\u9879<ul> <li>\u5d4c\u5957\u9879</li> </ul> </li> </ul> <p>\u6709\u5e8f\u5217\u8868\uff1a</p> <ol> <li>\u7b2c\u4e00\u6b65</li> <li>\u7b2c\u4e8c\u6b65</li> </ol> <p>\u4efb\u52a1\u5217\u8868\uff1a</p> <ul> <li> \u5df2\u5b8c\u6210\u7684\u4e8b</li> <li> \u5f85\u529e\u7684\u4e8b</li> </ul>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_4","title":"\u8868\u683c","text":"\u5217\u4e00 \u5217\u4e8c \u5217\u4e09 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_5","title":"\u4ee3\u7801\u5757","text":"<p>\u5e26\u8bed\u6cd5\u9ad8\u4eae\u548c\u884c\u53f7\uff0c\u53f3\u4e0a\u89d2\u6709\u4e00\u952e\u590d\u5236\u6309\u94ae\uff1a</p> <pre><code>def fibonacci(n: int):\n    \"\"\"\u751f\u6210\u6590\u6ce2\u90a3\u5951\u6570\u5217\u524d n \u9879\u3002\"\"\"\n    a, b = 0, 1\n    result = []\n    for _ in range(n):\n        result.append(a)\n        a, b = b, a + b\n    return result\n\nprint(fibonacci(10))\n</code></pre> <p>\u884c\u5185\u9ad8\u4eae\uff1a<code>print(\"hello\")</code> \u4e2d\u7684 <code>print</code> \u4e5f\u53ef\u4ee5\u5199\u6210 <code>print</code>\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_6","title":"\u63d0\u793a\u6846","text":"<p>\u8bf4\u660e</p> <p>\u8fd9\u662f\u4e00\u6761\u8bf4\u660e\u3002\u7c7b\u4f3c\u7684\u8fd8\u6709 <code>tip</code>\uff08\u6280\u5de7\uff09\u3001<code>warning</code>\uff08\u8b66\u544a\uff09\u3001<code>danger</code>\uff08\u5371\u9669\uff09\u3002</p> \u53ef\u6298\u53e0\u5185\u5bb9\uff08\u70b9\u51fb\u5c55\u5f00\uff09 <p>\u6298\u53e0\u5757\u9002\u5408\u653e\u957f\u4ee3\u7801\u6216\u8865\u5145\u7ec6\u8282\uff0c\u9ed8\u8ba4\u6536\u8d77\uff0c\u4e0d\u5360\u7248\u9762\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_7","title":"\u9009\u9879\u5361","text":"\u65b9\u6cd5\u4e00\u65b9\u6cd5\u4e8c <p>\u7b2c\u4e00\u79cd\u505a\u6cd5\u7684\u8bf4\u660e\u6216\u4ee3\u7801\u3002</p> <p>\u7b2c\u4e8c\u79cd\u505a\u6cd5\u7684\u8bf4\u660e\u6216\u4ee3\u7801\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_8","title":"\u6570\u5b66\u516c\u5f0f","text":"<p>\u884c\u5185\u516c\u5f0f\uff1a\u8d28\u80fd\u65b9\u7a0b \\(E = mc^2\\) \u51fa\u73b0\u5728\u53e5\u5b50\u4e2d\u95f4\u3002</p> <p>\u5757\u7ea7\u516c\u5f0f\u5355\u72ec\u6210\u884c\u5e76\u5c45\u4e2d\uff1a</p> \\[ \\int_{-\\infty}^{\\infty} e^{-x^2} \\, dx = \\sqrt{\\pi} \\] <p>\u591a\u884c\u5bf9\u9f50\u73af\u5883\uff1a</p> \\[ \\begin{aligned} \\nabla \\cdot \\mathbf{E} &amp;= \\frac{\\rho}{\\varepsilon_0} \\\\ \\nabla \\cdot \\mathbf{B} &amp;= 0 \\end{aligned} \\] <p>\u5199\u6cd5\u8981\u70b9\uff1a\u884c\u5185\u7528 <code>$...$</code>\uff0c\u5757\u7ea7\u7528 <code>$$...$$</code>\uff0c\u90fd\u7531 MathJax \u6e32\u67d3\u3002</p>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_9","title":"\u56fe\u7247","text":"<p>\u56fe\u7247\u8bed\u6cd5\u5982\u4e0b\uff08\u672c\u7ad9\u672a\u5185\u7f6e\u793a\u4f8b\u56fe\u7247\uff0c\u5b9e\u9645\u4f7f\u7528\u65f6\u628a <code>\u56fe\u7247\u8def\u5f84\u6216URL</code> \u6362\u6210\u771f\u5b9e\u5730\u5740\uff0c\u7ad9\u5185\u56fe\u7247\u5efa\u8bae\u653e\u5728 <code>docs/assets/</code> \u4e0b\uff09\uff1a</p> <pre><code>![\u56fe\u7247\u66ff\u4ee3\u6587\u5b57](\u56fe\u7247\u8def\u5f84\u6216URL)\n</code></pre>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/2026/09/06/markdown-guide/#_10","title":"\u811a\u6ce8\u4e0e\u5176\u4ed6","text":"<p>\u811a\u6ce8\u793a\u4f8b<sup>1</sup>\u3002</p> <p>\u7f29\u5199\u793a\u4f8b\uff08\u9f20\u6807\u60ac\u505c\u770b\u63d0\u793a\uff09\uff1aHTML \u662f\u4e00\u79cd\u6807\u8bb0\u8bed\u8a00\u3002</p> <ol> <li> <p>\u811a\u6ce8\u5185\u5bb9\u51fa\u73b0\u5728\u9875\u9762\u5e95\u90e8\u3002\u00a0\u21a9</p> </li> </ol>","tags":["Markdown","\u5199\u4f5c"]},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/%E5%85%AC%E5%91%8A/","title":"\u516c\u544a","text":""},{"location":"blog/category/%E6%95%99%E7%A8%8B/","title":"\u6559\u7a0b","text":""}]}